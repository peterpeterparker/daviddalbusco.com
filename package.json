{
	"name": "daviddalbusco.com",
	"private": true,
	"description": "David Dal Busco - Freelance Software Engineer",
	"version": "6.5.0",
	"author": "David Dal Busco <david@fluster.io>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"assets": "bun serve.assets.ts",
		"dev": "vite dev",
		"build:workaround": "node svelte.workaround.ts",
		"build": "vite build && pnpm build:workaround",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --check . && eslint . --fix",
		"format": "prettier --write .",
		"fmt": "pnpm run format",
		"e2e": "NODE_ENV=development playwright test",
		"e2e:ci": "playwright test --reporter=html",
		"e2e:snapshots": "playwright test --update-snapshots --reporter=list",
		"e2e:snapshots:local": "NODE_ENV=development playwright test --update-snapshots --reporter=list",
		"e2e:report": "playwright show-report",
		"e2e:playwright:install": "playwright install chromium --with-deps"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.2",
		"@types/remarkable": "^2.0.8",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-xml-parser": "^5.11.1",
		"globals": "^17.12.0",
		"kyushu-types": "0.2.1",
		"prettier": "^3.9.8",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"remarkable": "^2.0.1",
		"sass-embedded": "^1.104.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/peterpeterparker/daviddalbusco.com"
	},
	"bugs": {
		"url": "https://github.com/peterpeterparker/daviddalbusco.com/issues"
	},
	"overrides": {
		"cookie": "^0.7.0"
	},
	"dependencies": {
		"@apple/mapkit-loader": "^1.0.0",
		"layerchart": "^2.5.0",
		"yawa-tracker": "0.0.6"
	},
	"engines": {
		"node": ">=24",
		"npm": "please use pnpm",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@12.5.1"
}
